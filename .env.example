# Baza sozlamalari

# Backend sozlamalari
PORT=3000

# Bot sozlamalari
BOT_TOKEN="TELEGRAM_BOT_TOKEN_HERE"
BOT_MODE="polling" # yoki "webhook"
WEBHOOK_DOMAIN="https://api.yourdomain.com" # Agar webhook bo'lsa
BOT_PORT=3001 # Bot ichki API porti (internal notify uchun)

# Backend -> Bot aloqasi
BOT_INTERNAL_URL="http://localhost:3001/internal/notify"

# Frontend sozlamalari
WEBAPP_URL="https://your-mini-app-domain.com" # React Mini App manzili

# Admin va Eslatmalar
ADMIN_CHAT_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID"
# Eslatma har kuni 08:20 da Asia/Tashkent vaqt zonasi bo'yicha yuboriladi.
# Yoqish/o'chirish faqat developerning bot reply klaviaturasi orqali boshqariladi.
DATABASE_URL=file:/ram/dev.db
GITHUB_PRIMARY=1
GITHUB_RAM_DIR=/ram
ADMIN_WEBAPP_URL=https://davomat.provveb.uz
TEACHER_WEBAPP_URL=https://davomat.provveb.uz/teacher
