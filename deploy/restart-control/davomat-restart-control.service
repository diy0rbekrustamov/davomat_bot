[Unit]
Description=Davomat fixed-container restart control
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/davomat/control-service/server.py
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/davomat/control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=128M
TasksMax=64
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
